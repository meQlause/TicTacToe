	    	do Memory.poke(memAddress+354+x, -1);
	    	do Memory.poke(memAddress+386+x, -1);
	    	do Memory.poke(memAddress+418+x, -1);
	    	do Memory.poke(memAddress+450+x, -1);
	    	do Memory.poke(memAddress+482+x, -1);
	    	let x = x + 1;
	    }
	    return;
    }
	method void hor(int i) {
		var int memAddress;
		var int x;
		let x = 1;
		let memAddress = position[i-1] + Math.multiply(32, 32);
		while (x < 4) {
			do Memory.poke(memAddress+160+x, -1);
			do Memory.poke(memAddress+192+x, -1);
			do Memory.poke(memAddress+224+x, -1);
			do Memory.poke(memAddress+256+x, -1);
			do Memory.poke(memAddress+288+x, -1);
			let x = x + 1;
		}
		return;
	}
