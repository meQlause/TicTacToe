class Player {
    field Array arr;
    field int length;
    constructor Player new() {
        let arr = Array.new(9);
        let length = 0;
        return this;
    }

    method void add(int i) {
        let arr[length] = i;
        let length = length + 1;
        return; 
    }

    method int get(int i) {
        return arr[i];
    }

    method int length() {
        return length;
    }
}